<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_card">#FF1E2D42</color>
    <color name="bg_dark">#FF0D0D14</color>
    <color name="bg_medium">#FF141A2E</color>
    <color name="blue_light">#FF3385FF</color>
    <color name="blue_primary">#FF0066FF</color>
    <color name="error">#FFFF4444</color>
    <color name="success">#FF00CC66</color>
    <color name="text_primary">#FFF0F0FF</color>
    <color name="text_secondary">#FF7A80A0</color>
    <color name="vr_cyan">#FF00C9DB</color>
    <color name="warning">#FFFFAA00</color>
    <string name="app_name">GoConsole VR</string>
    <style name="Theme.GoConsoleVR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_light</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_medium</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
    <style name="Theme.GoConsoleVR.Fullscreen" parent="Theme.GoConsoleVR">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>